      {
        "name": "schedule_share_handoff",
        "title": "Schedule a Share-Sheet hand-off",
        "description": "Queue a rendered Campaign Kit for Share-Sheet hand-off on the chosen platforms at a target time. Creates staged variants only — the user still posts from their device.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kit_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID of the Studio campaign kit (campaigns.id) whose rendered assets should be queued."
            },
            "platforms": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "tiktok",
                  "instagram",
                  "youtube",
                  "linkedin"
                ]
              },
              "description": "Target platforms for the hand-off."
            },
            "scheduled_at": {
              "description": "ISO-8601 UTC target posting time. Omit to queue immediately.",
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "timezone": {
              "description": "IANA timezone label, default \"UTC\".",
              "type": "string",
              "maxLength": 60
            },
            "confirm": {
              "description": "Required true. Confirms creating queue items in the user's publishing calendar.",
              "type": "boolean"
            }
          },
          "required": [
            "kit_id",
            "platforms"
          ]
        },
